# 依赖
node_modules/

# 密钥（绝不提交）
.env

# 数据/产出/日志
# data/ 目录整体忽略，但 4 个静态配置资产随仓库发布（代码运行时读取，缺失则功能/测试失效）
data/*
!data/learning-sites.json
!data/career-sites.json
!data/knowledge-trees.json
!data/plugin-market.json
output/
progress.json
widget-run.log
*.log

# 构建产物 / 调试 / 第三方 runtime
desktop/renderer/app.bundle.js
desktop/renderer/test-direct.html
desktop/renderer/lib/
release/
coverage/

# 系统文件
Thumbs.db
.DS_Store

# 临时
*.tmp

# 实验中间产物
scripts/_*.npy
scripts/_short_origin.txt
scripts/_voiceid_mashiro.tsv

# 本地 ASR 模型（sherpa-onnx paraformer，~230MB，按需下载）
models/


# UI 截图产物（审计基线，不入库）
ui-shots/
# Python 缓存
__pycache__/
scripts/__pycache__/
scripts/tmp-*.mjs

# 内部评估/审计/战略文档——不上公开仓库（git rm --cached 保留本地）
docs/秋招项目评估-源码拷问抗压报告.md
docs/工程化现状台账.md
docs/工程化升级与简历包装指南.md
