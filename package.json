{
  "name": "mashiro-mcp",
  "version": "0.1.1",
  "description": "真白 · Mashiro 秋招助手 MCP Server——把秋招能力（面经搜索/讲解/学习清单/模拟面试/个人数据）接入任意支持 MCP 的 AI 工具（Claude Code/Cline 等）。桌面完整版（Live2D 桌宠+面板）见 GitHub: idontplaygenshinimpact/mashiro-desktop",
  "author": "wyyai",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "mashiro-mcp": "bin/mashiro-mcp.mjs"
  },
  "files": [
    "bin/",
    "lib/",
    "mcp-server.mjs",
    "config.mjs",
    "data/learning-sites.json",
    "data/career-sites.json",
    "data/knowledge-trees.json",
    "README.md"
  ],
  "imports": {
    "#lib/*": "./lib/*",
    "#root/*": "./*"
  },
  "main": "desktop/main.mjs",
  "scripts": {
    "run": "node run.mjs",
    "smoke": "node scripts/smoke-test.mjs",
    "e2e": "node scripts/electron-e2e.mjs",
    "test": "node --experimental-test-module-mocks --test \"tests/*.test.mjs\" --test-skip-pattern \"integration\" && node --test tests/integration-widget.test.mjs",
    "test:unit": "node --experimental-test-module-mocks --test \"tests/*.test.mjs\" --test-skip-pattern \"integration\"",
    "test:integration": "node --test \"tests/integration-widget.test.mjs\"",
    "bench": "node scripts/benchmark.mjs",
    "bench:quick": "node scripts/benchmark.mjs --quick",
    "bench:validate": "node scripts/validate-evaldata.mjs --report benchmark/evaldata-hashes.json",
    "bench:compare": "node scripts/bench-compare.mjs",
    "bench:gate": "node scripts/bench-compare.mjs --gate",
    "bench:ablation": "node scripts/bench-ablation.mjs",
    "bench:agent": "node --experimental-test-module-mocks scripts/benchmark-agent.mjs",
    "bench:web": "node scripts/web-task-bench.mjs",
    "typecheck": "tsc --noEmit",
    "typecheck:desktop": "tsc -p tsconfig.desktop.json",
    "lint": "eslint .",
    "coverage": "node --experimental-test-module-mocks --experimental-test-coverage --test \"tests/*.test.mjs\"",
    "dist": "electron-builder --win --publish never",
    "dist:portable": "electron-builder --win portable --publish never",
    "build:renderer": "esbuild desktop/renderer/app.js --bundle --format=esm --outfile=desktop/renderer/app.bundle.js --log-level=warning",
    "build:react-panel": "npm run build --prefix desktop/renderer/panel-react",
    "dev:react-panel": "npm run dev --prefix desktop/renderer/panel-react",
    "build:speech-queue": "esbuild desktop/renderer/speech-queue.mjs --format=iife --global-name=SpeechQueue --outfile=desktop/renderer/speech-queue.bundle.js --log-level=warning",
    "build:vue-review": "npm run build --prefix desktop/renderer/panel-vue-review",
    "dev:vue-review": "npm run dev --prefix desktop/renderer/panel-vue-review",
    "check:renderer": "node scripts/check-renderer.mjs",
    "voice:synth": "py -3.12 scripts/synth-mashiro-long.py",
    "voice:score": "py -3.12 scripts/score-voices.py --compare",
    "voice:audit": "py -3.12 scripts/audit-voices.py",
    "voice:train": "node scripts/voice-train/train.mjs",
    "voice:model": "node scripts/download-paraformer.mjs",
    "test:module": "node scripts/test-module.mjs"
  },
  "build": {
    "appId": "com.mashiro.desktop",
    "productName": "Mashiro",
    "electronVersion": "43.2.0",
    "npmRebuild": false,
    "files": [
      "desktop/**",
      "lib/**",
      "skills/**",
      "plugins/**",
      "widget.mjs",
      "config.mjs",
      "discover.mjs",
      "run.mjs",
      "mcp-server.mjs",
      "links.txt",
      "package.json"
    ],
    "asarUnpack": [
      "plugins/**"
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "真白"
    }
  },
  "dependencies": {
    "@andresaya/edge-tts": "^1.8.0",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@mozilla/readability": "^0.6.0",
    "@xenova/transformers": "^2.17.2",
    "imapflow": "^1.7.0",
    "jpeg-js": "^0.4.4",
    "jsdom": "^29.1.1",
    "koffi": "^3.1.4",
    "live2d-widget-model-mashiro-seifuku": "^1.0.1",
    "live2d-widget-model-mashiro-zamp": "^1.0.0",
    "live2d-widget-model-shizuku": "^1.0.5",
    "mammoth": "^1.12.0",
    "node-notifier": "^10.0.1",
    "pdfjs-dist": "^6.2.108",
    "pixi-live2d-display": "^0.4.0",
    "pixi.js": "^6.5.10",
    "playwright": "^1.62.1",
    "pngjs": "^7.0.0",
    "rss-parser": "^3.13.0",
    "sherpa-onnx-node": "^1.13.5",
    "ts-fsrs": "^5.4.1",
    "vue": "^3.5.42",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.1",
    "eslint": "^10.8.0",
    "globals": "^17.9.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "typescript": "^5.9.3"
  },
  "overrides": {
    "sharp": "^0.35.3",
    "uuid": "^11.1.1",
    "protobufjs": "^8.7.2",
    "gh-pages": "^6.0.0"
  }
}
